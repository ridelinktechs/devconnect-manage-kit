    "src/core/util.ts",
    "src/network/bodies.ts",
    "src/network/fetchPatch.ts",
    "src/network/requestInfo.ts",
    "src/network/xhrPatch.ts",
    "src/plugins/errors/errorMonitor.ts",
    "src/plugins/state/asyncTracker.ts",
    "src/interceptors/network/axiosInterceptor.ts",
    "src/interceptors/logging/logLibraryPlugins.ts",
    "src/interceptors/state/reduxMiddleware.ts",
    "src/interceptors/state/zustandMiddleware.ts",
    "src/interceptors/state/valtioPlugin.ts",
    "src/interceptors/state/jotaiPlugin.ts",
    "src/interceptors/state/xstatePlugin.ts",
    "src/interceptors/network/mockServerInterceptor.ts",
    "src/integrations/apollo.ts",
